{
  "name": "@cato/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "preflight": "node scripts/preflight.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:disposable": "node scripts/smoke-disposable-user.mjs",
    "test": "NODE_ENV=test node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cato/shared": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^8.3.1",
    "@supabase/supabase-js": "^2.45.0",
    "cloudinary": "^2.4.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "mongodb": "^6.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
